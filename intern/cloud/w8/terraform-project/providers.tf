terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.0"
    }
    null = {
      source  = "hashicorp/null"
      version = "~> 3.0"
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.0"
    }
  }
}

provider "aws" {
  region = var.region
}

# Provider thu 2 (sao chinh): deploy app vao cum.
# Doc kubeconfig do null_resource.kubeconfig keo ve. Connect "luoi" -> khong vo o plan.
provider "kubernetes" {
  config_path = "${path.module}/kubeconfig"
}
